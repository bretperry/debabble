{
  "about": "How debabble reads its argv and where it writes logs, for a guard that judges a debabble line without running it. Checked by test/contract.test.mjs. argv results: runs-command (command and args are what runs, with no shell), none (runs nothing: `hook …` and `list …` first words, and a lone --version; `list add|disable|enable` writes only the user wrap file under XDG_CONFIG_HOME), usage-error (exit 125, runs nothing). MARKER is replaced by a temp path in the test. logBase: env, --log-dir flag (null for none) and HOME give the base folder; debabble writes <base>/<repo>-<hash>/*.log and prunes *.log there.",
  "argv": [
    { "argv": ["--", "git", "push"], "result": "runs-command", "command": "git", "args": ["push"] },
    { "argv": ["--show", "excerpt", "--", "gh", "run", "view", "1"], "result": "runs-command", "command": "gh", "args": ["run", "view", "1"] },
    { "argv": ["--timeout", "90s", "--label", "x y", "--log-dir", "/l", "--", "pnpm", "test"], "result": "runs-command", "command": "pnpm", "args": ["test"] },
    { "argv": ["--timeout", "1500ms", "--", "make"], "result": "runs-command", "command": "make", "args": [] },
    { "argv": ["--timeout", "2", "--", "make"], "result": "runs-command", "command": "make", "args": [] },
    { "argv": ["--", "sh", "-c", "a; b", "--", "c"], "result": "runs-command", "command": "sh", "args": ["-c", "a; b", "--", "c"] },
    { "argv": ["--label", "--", "--", "ls"], "result": "usage-error" },
    { "argv": ["--", "--", "ls"], "result": "runs-command", "command": "--", "args": ["ls"] },
    { "argv": ["git", "push"], "result": "usage-error" },
    { "argv": [], "result": "usage-error" },
    { "argv": ["--"], "result": "usage-error" },
    { "argv": ["--", ""], "result": "usage-error" },
    { "argv": ["--show", "all", "--", "ls"], "result": "usage-error" },
    { "argv": ["--timeout", "0", "--", "ls"], "result": "usage-error" },
    { "argv": ["--timeout", "1d", "--", "ls"], "result": "usage-error" },
    { "argv": ["--timeout=90s", "--", "ls"], "result": "usage-error" },
    { "argv": ["--quiet", "--", "ls"], "result": "usage-error" },
    { "argv": ["--label", "--", "ls"], "result": "usage-error" },
    { "argv": ["-x", "--", "ls"], "result": "usage-error" },
    { "argv": ["--version"], "result": "none" },
    { "argv": ["hook", "claude"], "result": "none" },
    { "argv": ["hook", "--", "touch", "MARKER"], "result": "none" },
    { "argv": ["--version", "--", "touch", "MARKER"], "result": "usage-error" },
    { "argv": ["list", "show"], "result": "none" },
    { "argv": ["list", "add", "pnpm check", "--show", "verdict"], "result": "none" },
    { "argv": ["list", "add", "touch MARKER", "--show", "excerpt"], "result": "none" },
    { "argv": ["list", "disable", "git fetch"], "result": "none" },
    { "argv": ["list", "enable", "git fetch"], "result": "none" },
    { "argv": ["list", "disable", "nope", "--", "touch", "MARKER"], "result": "usage-error" },
    { "argv": ["list", "remove", "git fetch"], "result": "usage-error" },
    { "argv": ["list"], "result": "usage-error" },
    { "argv": ["list", "add", "x"], "result": "usage-error" }
  ],
  "logBase": [
    { "env": {}, "flag": "/f", "home": "/h", "base": "/f" },
    { "env": { "DEBABBLE_LOG_DIR": "/a", "XDG_STATE_HOME": "/s" }, "flag": "/f", "home": "/h", "base": "/f" },
    { "env": { "DEBABBLE_LOG_DIR": "/a", "XDG_STATE_HOME": "/s" }, "flag": null, "home": "/h", "base": "/a" },
    { "env": { "DEBABBLE_LOG_DIR": "", "XDG_STATE_HOME": "/s" }, "flag": null, "home": "/h", "base": "/s/debabble" },
    { "env": { "XDG_STATE_HOME": "/s" }, "flag": null, "home": "/h", "base": "/s/debabble" },
    { "env": { "XDG_STATE_HOME": "" }, "flag": null, "home": "/h", "base": "/h/.local/state/debabble" },
    { "env": {}, "flag": null, "home": "/h", "base": "/h/.local/state/debabble" },
    { "env": { "DEBABBLE_LOG_DIR": "/a/../b" }, "flag": null, "home": "/h", "base": "/b" }
  ]
}
